#세트(set)
#생성
fruit_set = {'사과','바나나','오렌지'}
print(fruit_set)
#중복을 허락하지 않는다.
fruit_set = {'사과','바나나','오렌지','사과','바나나'}
print(fruit_set)
#선택: 인텍싱 개념이 없다.
#fruit_set[1]

#추가
fruit_set.add('키위')
print(fruit_set)
#확장
vegetable_set = {'당근','토마토','양파'}
fruit_set.update(vegetable_set)
print(fruit_set)
fruit_set.remove('양파')
print(fruit_set)
fruit_set.clear()
print(fruit_set)