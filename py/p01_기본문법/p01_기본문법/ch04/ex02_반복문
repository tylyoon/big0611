# 반복문 연습
shopping_dict = {
    '주문번호' : 123,
    '주문자' : '김**',
    '주소' : '서울 마포구 상암동',
    '주문항목' : ['맛좋은 김치','맛좋은 라면','시워한 물']
}

for key in shopping_dict:
    print(key)
for item in shopping_dict.items():
    print(item)
print(shopping_dict)
for key,value in shopping_dict.items():
    print(key)
    print(value)
    print('------')
