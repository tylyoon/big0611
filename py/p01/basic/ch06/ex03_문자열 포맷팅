name = "철수"
age = 25

# 기본 사용 1세대,2세대,3세대
print("이름: %s, 나이: %d세" % (name, age))
print("이름: {}, 나이: {}세".format(name, age))
print(f"이름: {name}, 나이: {age}세")
# 출력: 이름: 철수, 나이: 25세

# 실수 소수점 제한 (소수점 아래 2자리까지 표기)
# 1세대,2세대,3세대
pi = 3.141592
print("원주율: %.2f" % pi)
print("원주율: {:.2f}".format(pi))
print(f"원주율: {pi:.2f}")  